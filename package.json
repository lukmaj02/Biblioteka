{
  "name": "biblioteka",
  "version": "1.0.0",
  "private": true,
  "description": "Domowa biblioteka — księgozbiór, wypożyczenia i etykiety",
  "author": "Biblioteka",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "icon": "bash scripts/generate-icon.sh",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "concurrently -k -n next,electron -c blue,magenta \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:build": "npm run icon && npm run build && npm run desktop:prepare && electron-builder --mac",
    "desktop:pack": "npm run desktop:build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "jsbarcode": "^3.12.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "pl.domowa.biblioteka",
    "productName": "Biblioteka",
    "copyright": "Copyright © Biblioteka",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build/next-server",
        "to": "next",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "afterPack": "./scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "dmg": {
      "title": "Biblioteka",
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
